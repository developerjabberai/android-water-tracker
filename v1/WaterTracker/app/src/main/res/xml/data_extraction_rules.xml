<?xml version="1.0" encoding="utf-8"?>
<!-- Only the app's own small settings file is backed up or transferred: goal, log, creeper level. Nothing else. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="water.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="water.xml" />
    </device-transfer>
</data-extraction-rules>
